CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# ESP32-S3-EYE onboard camera SCCB (SIOD=GPIO4, SIOC=GPIO5); aligns with BSP / IDF dvp_spi_lcd.
CONFIG_EXAMPLE_CAM_SCCB_SDA_GPIO=4
CONFIG_EXAMPLE_CAM_SCCB_SCL_GPIO=5

CONFIG_EXAMPLE_CAM_XCLK_SETTLE_MS=150
CONFIG_EXAMPLE_CAM_SCCB_FREQ_KHZ=40
CONFIG_EXAMPLE_CAM_I2C_PROBE=y
