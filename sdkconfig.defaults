# CONFIG_EXAMPLE_ENABLE_LCD is not set

# CONFIG_CAMERA_OV2640 is not set
CONFIG_EXAMPLE_CAMERA_SENSOR_OV3660=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3660_DVP_YUV422_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_IF_FORMAT_INDEX_DEFAULT=1

CONFIG_EXAMPLE_CAM_SCCB_SDA_GPIO=4
CONFIG_EXAMPLE_CAM_SCCB_SCL_GPIO=5

CONFIG_EXAMPLE_CAM_XCLK_SETTLE_MS=150
CONFIG_EXAMPLE_CAM_SCCB_FREQ_KHZ=40
CONFIG_EXAMPLE_CAM_I2C_PULLUP_INTERNAL=y
CONFIG_EXAMPLE_CAM_I2C_PROBE=y

# --- OV5640 example (uncomment and comment out OV3660 lines above after fresh sdkconfig) ---
# CONFIG_EXAMPLE_CAMERA_SENSOR_OV3660 is not set
# CONFIG_CAMERA_OV3660 is not set
# CONFIG_EXAMPLE_CAMERA_SENSOR_OV5640=y
# CONFIG_CAMERA_OV5640=y
# CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
